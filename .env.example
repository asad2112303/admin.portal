# ---------------------------------------------------------------------------
# eShifa Admin Portal — environment configuration
#
# Copy to `.env.local`. That file is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- MariaDB ----------------------------------------------------------------
# Schema, accounts and server setup live with the public website:
# db/mariadb/README.md in that repository.
#
# The account is eshifa_admin. It holds no privilege on any table: it reads
# through the *_secure views, filtered by its row-level policies, and changes a
# status only through set_callback_status(), which also writes the audit entry.
# It cannot edit patient details or delete anything.
#
# Same server (Hetzner): the Unix socket. Nothing crosses a network.
DATABASE_SOCKET_PATH=/run/mysqld/mysqld.sock
# Remote server: TCP instead (set SOCKET_PATH or HOST, not both). TLS is then
# always on and the certificate always verified.
# DATABASE_HOST=db.example.internal
# DATABASE_PORT=3306
# DATABASE_SSL_CA_FILE=/etc/eshifa/mariadb-ca.pem
DATABASE_NAME=eshifa
DATABASE_USER=eshifa_admin
DATABASE_PASSWORD=
# How long to wait for the database before answering 503, in ms.
# DATABASE_TIMEOUT_MS=8000

# --- Sign-in ----------------------------------------------------------------
# The single admin account. Generate all three with: npm run set-admin-password
# The password itself is never stored, only its scrypt hash.
ADMIN_EMAIL=admin@shifa.com.pk
ADMIN_PASSWORD_HASH=scrypt:...:...
ADMIN_SESSION_SECRET=random-32-bytes-base64url
